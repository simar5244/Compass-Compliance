# Backend configuration. Copy to backend/.env and fill in.

# Postgres. Port matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://wcag:wcag@localhost:55433/wcag_scanner

# Redis. Port matches docker-compose.yml.
REDIS_URL=redis://localhost:6381/0

# Comma-separated origins allowed to call the API directly. Behind the nginx
# sub-path deployment the browser talks to the app's own origin, so this only
# matters for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Crawl budget.
CRAWL_MAX_PAGES_DEFAULT=400
CRAWL_MAX_DEPTH_DEFAULT=4
CRAWL_CONCURRENCY=3

# Session cookie scope. Must match the frontend basePath in production so the
# cookie is not offered to other apps on the same domain.
#   production: /compass
SESSION_COOKIE_PATH=/

# Send the session cookie only over HTTPS. Set to 1 in any TLS deployment.
SESSION_COOKIE_SECURE=0

# Required for the AI issue-explanation feature.
OPENAI_API_KEY=
