# Compose build/runtime variables for the deployed stack.
# Copy to .env next to docker-compose.yml:  cp .env.example .env

# Where the BROWSER sends API requests. Inlined into the client bundle at build
# time, so changing it requires `docker compose build frontend`.
# Same-origin behind nginx at /compass (recommended):
NEXT_PUBLIC_API_URL=/compass/api
# Separate API origin instead:
# NEXT_PUBLIC_API_URL=https://api.example.com

# Where the Next server forwards /compass/api/* internally. This is a BUILD
# argument — Next freezes it into the build, so changing it requires
# `docker compose build frontend`. Must be resolvable from inside the frontend
# container — never localhost.
# Backend running on the host:
BACKEND_API_URL=http://host.docker.internal:8001
# Backend as a compose service:
# BACKEND_API_URL=http://backend:8001

# Per-page Lighthouse performance checks. On by default in the compose
# deployment; adds roughly 10-15s per page. Web vitals (the site's front door)
# are measured separately and are always on.
ENABLE_LIGHTHOUSE=1
